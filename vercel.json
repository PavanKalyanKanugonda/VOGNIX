{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "vite",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
      ]
    },
    "backend": {
      "root": "backend/",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/api-docs", "destination": { "service": "backend" } },
    { "source": "/api-docs/(.*)", "destination": { "service": "backend" } },
    { "source": "/v3/api-docs/(.*)", "destination": { "service": "backend" } },
    { "source": "/swagger-ui.html", "destination": { "service": "backend" } },
    { "source": "/swagger-ui/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
