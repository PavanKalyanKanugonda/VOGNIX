# syntax=docker/dockerfile:1
# -----------------------------------------------------------
# Stage 1: Build JAR using Maven on official Eclipse Temurin
# -----------------------------------------------------------
FROM maven:3.9.9-eclipse-temurin-17 AS builder
WORKDIR /build

# Pre-cache dependencies
COPY pom.xml .
RUN mvn -B -DskipTests dependency:go-offline || true

# Copy source and build executable fat JAR
COPY src ./src
RUN mvn -B -DskipTests clean package

# -----------------------------------------------------------
# Stage 2: Minimal, robust JRE runtime image
# -----------------------------------------------------------
FROM eclipse-temurin:17-jre
WORKDIR /app

# Copy compiled Spring Boot JAR
COPY --from=builder /build/target/vognix-backend-1.0.0.jar /app/app.jar

ENV PORT=80
ENV SPRING_JPA_OPEN_IN_VIEW=false
ENV SPRING_MAIN_LAZY_INITIALIZATION=true
EXPOSE 80

# Dynamically adapt to container RAM limit and bind to Vercel's PORT
ENTRYPOINT ["sh", "-c", "exec java -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseSerialGC -Djava.security.egd=file:/dev/./urandom -Dserver.port=${PORT:-80} -jar /app/app.jar"]
